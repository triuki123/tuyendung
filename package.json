{
  "name": "assetflowpro",
  "version": "1.1.0",
  "private": true,
  "rocketCritical": {
    "dependencies": [
      "next",
      "react",
      "react-dom",
      "@dhiwise/component-tagger",
      "@tailwindcss/typography",
      "recharts"
    ],
    "devDependencies": [
      "typescript",
      "@types/node",
      "@types/react",
      "@types/react-dom",
      "@typescript-eslint/eslint-plugin",
      "@typescript-eslint/parser",
      "eslint-config-next",
      "tailwindcss",
      "autoprefixer",
      "postcss",
      "eslint",
      "prettier",
      "@netlify/plugin-nextjs"
    ],
    "scripts": [
      "dev",
      "build",
      "start",
      "lint",
      "lint:fix",
      "format",
      "serve",
      "type-check"
    ],
    "warning": "🚨 CRITICAL: DO NOT REMOVE OR MODIFY ABOVE DEPENDENCIES - Required for Next.js 15 TypeScript app functionality"
  },
  "scripts": {
    "dev": "node scripts/dev-local.mjs",
    "restart:local": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/restart-local.ps1",
    "dev-no-port": "next dev",
    "build": "next build",
    "start": "node scripts/dev-local.mjs",
    "start:local": "next start -p 4028",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md,json}\"",
    "serve": "next start",
    "type-check": "tsc --noEmit",
    "check-db": "node scripts/check-db-columns.js",
    "migrate": "node scripts/run-migrations.js",
    "migrate:direct": "node scripts/run-migration-direct.js",
    "dev:test": "next dev -p 3001",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "lint:colors": "node scripts/check-no-raw-colors.js",
    "lint:colors:update": "node scripts/check-no-raw-colors.js --update"
  },
