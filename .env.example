# Database (PostgreSQL self-hosted)
DATABASE_URL=postgres://user:pass@host:5432/db
# Hoặc dùng riêng lẻ thay vì DATABASE_URL:
# PGHOST=
# PGPORT=5432
# PGUSER=
# PGPASSWORD=
# PGDATABASE=
PGSSL=false
PG_POOL_MAX=30

NEXT_PUBLIC_APP_URL=http://localhost:4028

# Email (tùy chọn, cho password-reset)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=

# FADO SSO (OIDC) — luồng đăng nhập chính, bắt buộc có trên mọi môi trường.
# Thiếu → /api/auth/sso/start báo "SSO_CLIENT_ID / SSO_CLIENT_SECRET chưa được cấu hình trong env".
SSO_ISSUER=https://sso.fadoai.com/oidc
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# M2M (đồng bộ user sang SSO — ssoProvisioningService)
SSO_M2M_CLIENT_ID=
SSO_M2M_CLIENT_SECRET=

# Zimbra (server-side only)
ZIMBRA_ADMIN_URL=
ZIMBRA_ADMIN_USER=
ZIMBRA_ADMIN_PASSWORD=
ZIMBRA_TLS_REJECT_UNAUTHORIZED=false
ZIMBRA_DEFAULT_PASSWORD_SUFFIX=@123

# MinIO (S3-compatible object storage — thay thế dần việc lưu file BYTEA trong Postgres,
# xem migrations/302_create_media_table.sql + scripts/migrate-media/)
S3_ENDPOINT=https://assetflow-minio.fadoai.com
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_BUCKET=assetflow
