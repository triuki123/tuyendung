{
  "manifest_version": 3,
  "name": "AssetFlow CV Collector",
  "version": "1.3.1",
  "description": "Thu thap thong tin ung vien tu trang dang mo va dua vao Kho Ung Vien AssetFlow.",
  "permissions": ["activeTab", "scripting", "storage", "tabs", "unlimitedStorage"],
  "host_permissions": ["https://tuyendung.topcv.vn/*", "https://assetflow.fadoai.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://tuyendung.topcv.vn/*"],
    "js": ["topcv.js"],
    "css": ["topcv.css"],
    "run_at": "document_idle"
  }, {
    "matches": ["https://assetflow.fadoai.com/*"],
    "js": ["assetflow-bridge.js"],
    "run_at": "document_idle"
  }],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Luu CV vao AssetFlow",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options.html"
}
