# ============================================================================
# AssetFlow Pro — environment (self-hosted Postgres, no Supabase)
# ============================================================================

# Postgres connection. Use either DATABASE_URL or the discrete PG* vars below.
DATABASE_URL=postgres://assetflow:assetflow@localhost:5432/assetflow
# PGHOST=localhost
# PGPORT=5432
# PGUSER=assetflow
# PGPASSWORD=assetflow
# PGDATABASE=assetflow
# PGSSL=false
# PG_POOL_MAX=10

# App base URL (used to build password-reset links). NEXT_PUBLIC_* is inlined
# at build time, so set it before `next build` / docker build.
NEXT_PUBLIC_APP_URL=http://localhost:4028

# Email (AWS SES) — optional; required only for password-reset mail.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=

# Zimbra Admin API — server-side only, never exposed to client
ZIMBRA_ADMIN_URL=https://zimbra.example.com:7071/service/admin/soap
ZIMBRA_ADMIN_USER=admin@example.com
ZIMBRA_ADMIN_PASSWORD=
ZIMBRA_TLS_REJECT_UNAUTHORIZED=false
# ZIMBRA_CA_CERT=      # Optional PEM cert for TLS pinning
ZIMBRA_DEFAULT_PASSWORD_SUFFIX=@123

# Giao diện Sáng (dark launch): =true để bật toggle light. Bỏ trống/false = khoá (chỉ dark).
NEXT_PUBLIC_ENABLE_LIGHT_THEME=false

# FADO SSO (sso.fadoai.com) — điền giá trị thật từ SSO backoffice (KHÔNG commit .env)
# Client OIDC đăng nhập (confidential) + client M2M provisioning (scope users:write)
SSO_ISSUER=https://sso.fadoai.com/oidc
SSO_CLIENT_ID=assetflow-web
SSO_CLIENT_SECRET=
SSO_M2M_CLIENT_ID=assetflow-provisioner
SSO_M2M_CLIENT_SECRET=

# Optional legacy administrative scripts (set locally when needed)
SUPABASE_SECRET_KEY=
ADMIN_INITIAL_PASSWORD=
